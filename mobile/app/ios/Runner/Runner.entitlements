<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push über APNs (Firebase Cloud Messaging). Beim Export für den App Store wird daraus «production». -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Kritische Hinweise (ertönen auch bei «Nicht stören» und Lautlos, Alarmstufe «kritisch»), von Apple freigegeben.
	     Das Provisioning-Profil (Secret IOS_PROFILE_BASE64) muss die Fähigkeit enthalten, sonst scheitert der Build. -->
	<key>com.apple.developer.usernotifications.critical-alerts</key>
	<true/>
	<!-- Zeitkritische Hinweise (Alarmstufe «hoch», durchbrechen einen Fokus). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Push to Talk (com.apple.developer.push-to-talk) erst eintragen, wenn das PushToTalk-Framework eingebaut ist (Issue #113, offen). -->
</dict>
</plist>
