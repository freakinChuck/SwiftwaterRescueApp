<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS (lokales DEV, MyASP): Sicherheits-Header wie in .htaccess (Issue #271). Apache/LiteSpeed ignorieren die Datei.
     HSTS setzt die API selbst, nur über HTTPS (IIS kann den Header hier nicht von HTTPS abhängig machen). -->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(self), microphone=(self), camera=(self), payment=(), usb=()" />
        <add name="Content-Security-Policy" value="frame-ancestors 'self'; object-src 'none'; base-uri 'self'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
