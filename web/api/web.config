<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: Antworten der API mit Status ab 400 (z. B. 401 «Benutzername oder Passwort falsch») unverändert weitergeben.
     Sonst ersetzt IIS den JSON-Inhalt durch eine eigene HTML-Fehlerseite, und die App zeigt nur «Serverfehler». Apache/LiteSpeed ignorieren die Datei. -->
<configuration>
    <system.webServer>
        <httpErrors existingResponse="PassThrough" />
    </system.webServer>
</configuration>
