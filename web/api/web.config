<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: Antworten der API mit Status ab 400 (z. B. 401 «Benutzername oder Passwort falsch») unverändert weitergeben.
     Sonst ersetzt IIS den JSON-Inhalt durch eine eigene HTML-Fehlerseite, und die App zeigt nur «Serverfehler». Apache/LiteSpeed ignorieren die Datei. -->
<configuration>
    <system.webServer>
        <httpErrors existingResponse="PassThrough" />
        <!-- Sicherheits-Header setzt die API selbst (Issue #271, doc/get mit eigener CSP); die Werte aus ../web.config hier nicht doppeln -->
        <httpProtocol>
            <customHeaders>
                <remove name="X-Content-Type-Options" />
                <remove name="X-Frame-Options" />
                <remove name="Referrer-Policy" />
                <remove name="Permissions-Policy" />
                <remove name="Content-Security-Policy" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
