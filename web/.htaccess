# HTML, JS und CSS bei jedem Aufruf beim Server prüfen lassen (ETag/Last-Modified, meist nur «304 Not Modified»).
# Sonst verwenden Handys nach einem Update teils noch alte Dateien (z. B. altes common.js zu neuem index.html → grauer Bildschirm).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|webmanifest|md|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
# Sicherheits-Header (Issue #271) für alle Dateien ausser PHP; die API setzt sie selbst (api/index.php, doc/get mit eigener CSP «sandbox»),
# sonst überschriebe Apache dort ihre Werte bzw. doppelte sie.
# Fremde Seiten dürfen die App nicht einbetten (Clickjacking), keine MIME-Erkennung, Referer nur mit Host, Gerätefunktionen nur für die eigenen Seiten.
# public.html, funk.html, dok.html usw. setzen ihren Referer weiterhin selbst (meta referrer geht vor).
<IfModule mod_headers.c>
 <FilesMatch "\.(?!php$)[^.]+$">
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), microphone=(self), camera=(self), payment=(), usb=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
 </FilesMatch>
</IfModule>
# PWA (Issue #67): Manifest mit dem richtigen Typ ausliefern; sw.js ist JS und wird damit ebenfalls bei jedem Aufruf geprüft
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  # Kapitel der Bedienungsanleitung (Issue #37, hilfe/*.md)
  AddType "text/markdown; charset=utf-8" .md
  # Eigene OSM-Karte (Issue #106, tiles/osm.pmtiles): Vektorkacheln, gelesen über Teilabfragen (Range)
  AddType application/vnd.pmtiles .pmtiles
</IfModule>
# Eigene OSM-Karte (Issue #106): nicht komprimieren (sonst funktionieren Teilabfragen nicht), einen Tag zwischenspeichern (neue Datei = neues ETag)
<FilesMatch "\.pmtiles$">
  <IfModule mod_env.c>
    SetEnv no-gzip 1
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=86400"
  </IfModule>
</FilesMatch>
