<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS (lokales DEV, MyASP) kennt .md nicht und liefert sonst 404: Kapitel der Bedienungsanleitung (Issue #37) -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown; charset=utf-8" />
    </staticContent>
  </system.webServer>
</configuration>
